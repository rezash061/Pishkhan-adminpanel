# AdminApi base URL (private network). Use "mock" to run against the in-process mock AdminApi.
ADMIN_API_URL=http://localhost:5081
# Required to allow ADMIN_API_URL=mock in a production build (end-to-end tests only).
# ADMIN_ALLOW_MOCK=1
# Optional second layer behind the VPN: comma-separated client IPs or IPv4 CIDR ranges.
# ADMIN_ALLOWED_IPS=10.8.0.0/16
# Cookies are Secure (__Host- prefixed) in production builds. Force with true/false if needed.
# ADMIN_COOKIE_SECURE=true
# Idle timeout (seconds) and warning lead time. Build-time values; the backend enforces its own 15 minutes too.
# NEXT_PUBLIC_ADMIN_IDLE_SECONDS=900
# NEXT_PUBLIC_ADMIN_IDLE_WARN_SECONDS=120
# Public website URL, used to open draft previews from the content editor.
# NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
